{
  "proxy": {
    "request_listeners": [
      {
        "certificate_mode": "per_host",
        "enable_http2": true,
        "listen_mode": "all_interfaces",
        "listener_port": 8080,
        "running": true
      }
    ]
  },
  "target": {
    "scope": {
      "advanced_mode": true,
      "include": [
        {
          "enabled": true,
          "host": "^ofbiz$",
          "port": "^8443$",
          "protocol": "https"
        }
      ],
      "exclude": [
        {
          "enabled": true,
          "host": "^ofbiz$",
          "port": "^8443$",
          "protocol": "https",
          "file": ".*(logout|Logout).*"
        }
      ]
    }
  },
  "scanner": {
    "application_logins": [
      {
        "enabled": true,
        "type": "UsernameAndPasswordCredentials",
        "username": "__RUNTIME_USERNAME__",
        "password": "__RUNTIME_PASSWORD__"
      }
    ]
  },
  "project_options": {
    "connections": {
      "upstream_proxy": {
        "use_user_options": false
      },
      "ssl": {
        "disable_http2": false,
        "enable_sni": true,
        "negotiate_alpn": true
      }
    }
  }
}
