# Existing Apache OFBiz source tree. Its Dockerfile demo target is used.
OFBIZ_SOURCE=/home/krishna/Pictures/ofbiz-framework

# Existing licensed native Burp installation. The agent never deletes or resets it.
BURP_EXECUTABLE=/home/krishna/BurpSuite/BurpSuite

# Used independently by Burp crawler login and the agent's standby session.
OFBIZ_USERNAME=admin
OFBIZ_PASSWORD=ofbiz

# The only crawl seed. Discovered target paths are allowed except Ecommerce.
TARGET_URL=https://localhost:8443/webtools/control/main

# Generate with: openssl rand -hex 32
BURP_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
BURP_BRIDGE_PORT=1338

# Burp Settings > Suite > REST API. Keep this listener on loopback.
BURP_REST_API_URL=http://127.0.0.1:1337
BURP_REST_API_KEY=replace-with-the-api-key-generated-by-burp

ARTIFACTS_DIR=artifacts
OFBIZ_STARTUP_SECONDS=900
BURP_STARTUP_SECONDS=300
# Polling cadence only; this is not a scan timeout or completion heuristic.
SCAN_POLL_SECONDS=15
SESSION_CHECK_SECONDS=60
