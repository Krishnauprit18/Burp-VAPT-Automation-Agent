OFBIZ_SOURCE=/absolute/path/to/ofbiz-framework
OFBIZ_USERNAME=replace-me
OFBIZ_PASSWORD=replace-me
SCAN_SEED_URLS=https://ofbiz:8443/webtools/control/main,https://ofbiz:8443/accounting/control/main
TARGET_HOST=ofbiz
BURP_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
BURP_BRIDGE_PORT=1338
BURP_PROXY_PORT=8080
DISPLAY=:0
CRAWL_IDLE_SECONDS=180
MAX_CRAWL_SECONDS=7200
MAX_AUDIT_SECONDS=14400
MAX_SCAN_SECONDS=18000
SCAN_POLL_SECONDS=15
